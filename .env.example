# 复制为 .env 供 docker compose 读取（仅本地开发示例，生产必须更换密钥）
DB_USER=mcp
DB_PASSWORD=mcp
# Grafana 管理台密码（默认 admin，暴露在共享网络时务必修改）
GRAFANA_ADMIN_PASSWORD=admin
# vredis 后端地址：必须是 gateway 容器可达的地址（宿主机 vredis 用 host.docker.internal:<端口>，
# 注意别撞上本文件里已占用的宿主端口，如 9090 已被 PROMETHEUS_HOST_PORT 占用）。
# 留空 = 未部署 vredis，工具调用返回结构化的 vredis_unavailable JSON（网关其余功能不受影响）。
VREDIS_BASE_URL=

# 宿主机端口映射：与已有服务冲突时改这里（容器内端口不变）
POSTGRES_HOST_PORT=5432
GATEWAY_HOST_PORT=8080
# 第二网关实例（多实例验证/滚动升级用；不需要时可在 compose 里删除该服务）
GATEWAY2_HOST_PORT=18081
UPSTREAM_TIME_HOST_PORT=8090
UPSTREAM_WEATHER_HOST_PORT=8091
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000

